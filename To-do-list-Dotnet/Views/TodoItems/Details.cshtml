@model To_do_list_Dotnet.Models.TodoItem

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<div>
    <h4>TodoItem</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Task Name
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskName)
        </dd>

        <dt>
            Task Description
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskDesc)
        </dd>

        <dt>
            Date and Time Start
        </dt>

        <dd>
            @*@Html.DisplayFor(model => model.DateStart)*@
            @(Model.DateStart?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>

        <dt>
            Date and Time End
        </dt>

        <dd>
            @*@Html.DisplayFor(model => model.DateEnd)*@
            @(Model.DateEnd?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>

        <dt>
            Status
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskStatus)
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Index")
</p>
