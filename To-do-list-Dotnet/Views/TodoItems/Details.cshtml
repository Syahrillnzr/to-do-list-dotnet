@model To_do_list_Dotnet.Models.TodoItem


@{
    ViewBag.Title = "Details";
}

<br>
<h2>Details</h2>

<div>

    <hr />
    <dl class="dl-horizontal">
        <dt>
            Task Name
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskName)
        </dd>

        <dt>
            Task Description
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskDesc)
        </dd>

        <dt>
            Date and Time Start
        </dt>

        <dd>
            @*@Html.DisplayFor(model => model.DateStart)*@
            @(Model.DateStart?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>

        <dt>
            Date and Time End
        </dt>

        <dd>
            @*@Html.DisplayFor(model => model.DateEnd)*@
            @(Model.DateEnd?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>

        <dt>
            Status
        </dt>

        <dd>
            @To_do_list_Dotnet.Helpers.EnumHelper.GetDisplayName(Model.TaskStatus)
        </dd>

    </dl>
</div>

<br>
<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-secondary ms-2" })
        @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary ms-2" })
    </div>
</div>
