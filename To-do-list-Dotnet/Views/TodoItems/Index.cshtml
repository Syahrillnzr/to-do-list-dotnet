

@model IEnumerable<To_do_list_Dotnet.Models.TodoItem>

@{
    ViewBag.Title = "Index";
}

<br>
<p>
    <span style="font-size:16px; font-weight:bold">
        <i class="fas fa-plus-circle"></i> @Html.ActionLink("Create New", "Create")
    </span>
</p>

<table class="table">
    <tr>
        <th>
            Task Name
        </th>
        <th>
            Task Description
        </th>
        <th>
            Date and Time Start
        </th>
        <th>
            Date and Time End
        </th>
        <th>
            Status
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TaskName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaskDesc)
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.DateStart)*@
                @(item.DateStart?.ToString("dd/MM/yyyy hh:mm tt"))
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.DateEnd)*@
                @(item.DateEnd?.ToString("dd/MM/yyyy hh:mm tt"))
            </td>
            <td>
                @To_do_list_Dotnet.Helpers.EnumHelper.GetDisplayName(item.TaskStatus)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
    }

</table>
