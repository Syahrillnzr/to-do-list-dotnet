@model To_do_list_Dotnet.Models.TodoItem

@{
    ViewBag.Title = "Delete";
}

<br>
<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Task Name
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskName)
        </dd>

        <dt>
            Task Description
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskDesc)
        </dd>

        <dt>
            Date and Time Start
        </dt>

        <dd>
            @(Model.DateStart?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>

        <dt>
            Date and Time End
        </dt>

        <dd>
            @(Model.DateEnd?.ToString("dd/MM/yyyy hh:mm tt"))
        </dd>
        <dt>
            Status
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TaskStatus)
        </dd>

    </dl>


    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()


        <br>
        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    }
</div>
